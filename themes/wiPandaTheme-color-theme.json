  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#676B79",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#FF75B5"
      }
    },
    {
      "scope": "keyword.control, keyword.operator.new",
      "settings": {
        "foreground": "#FF75B5"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#E6E6E6"
      }
    },
    {
      "scope": "keyword.operator.logical, keyword.operator.comparison",
      "settings": {
        "foreground": "#FFCC95"
      }
    },
    {
      "scope": "keyword.operator.misc, keyword.operator.sigil",
      "settings": {
        "foreground": "#FF75B5"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#FFB86C"
      }
    },
    {
      "scope": "constant",
      "settings": {
        "foreground": "#FFB86C"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#13bea4"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#E6E6E6"
      }
    },
    // 函数参数变量的颜色
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#BBBBBB"
      }
    },
    // 对象解构绑定变量的颜色
    {
      "scope": "meta.object-binding-pattern-variable.js variable",
      "settings": {
        "foreground": "#FFCC95"
      }
    },
    // 常量、this关键字和插值变量的颜色
    {
      "scope": "variable.other.constant, variable.language.this, variable.interpolation",
      "settings": {
        "foreground": "#FF9AC1"
      }
    },
    // 对象属性的颜色
    {
      "scope": "variable.other.property",
      "settings": {
        "foreground": "#E6E6E6"
      }
    },
    // 非法语法的样式
    {
      "scope": "invalid.illegal",
      "settings": {
        "border-bottom": "1px dashed rgba(255, 44, 109, 0.5)"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "background-foreground": "rgba(255, 44, 109, 0.62)"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#19f9d8"
      }
    },
    {
      "scope": "punctuation.definition.template-expression",
      "settings": {
        "foreground": "#FFCC95"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#FFCC95"
      }
    },
    // 支持类的颜色
    {
      "scope": "support.class",
      "settings": {
        "foreground": "#FFCC95"
      }
    },
    // JavaScript模块对象的颜色
    {
      "scope": "support.type.object.module.js",
      "settings": {
        "foreground": "#B084EB"
      }
    },
    // 支持函数的颜色
    {
      "scope": "support.function",
      "settings": {
        "foreground": "#1ae1c4"
      }
    },
    // 函数名的颜色
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#1ae1c4"
      }
    },
    // 继承类的颜色
    {
      "scope": "entity.other.inherited-class",
      "settings": {
        "foreground": "#FF9AC1"
      }
    },
    // YAML标签名的颜色
    {
      "scope": "entity.name.tag.yaml",
      "settings": {
        "foreground": "#FFCC95"
      }
    },
    // 装饰器标点的颜色
    {
      "scope": "meta.decorator punctuation.decorator",
      "settings": {
        "foreground": "#FFB86C"
      }
    },
    // 装饰器变量的颜色
    {
      "scope": "meta.decorator variable",
      "settings": {
        "foreground": "#1ae1c4"
      }
    },
    // 特殊方法关键字（如constructor、toString）的颜色
    {
      "scope": "keyword.other.special-method",
      "settings": {
        "foreground": "#13bea4"
      }
    },
    // CSS at-rule关键字（如@media、@keyframes）的颜色
    {
      "scope": "keyword.control.at-rule",
      "settings": {
        "foreground": "#B084EB"
      }
    },
    // !important关键字的颜色
    {
      "scope": "keyword.other.important",
      "settings": {
        "foreground": "#FF4B82"
      }
    },
    // 变量插值的颜色
    {
      "scope": "variable.interpolation",
      "settings": {
        "foreground": "#FF75B5"
      }
    },
    // 类型名的颜色和样式
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#19f9d8",
        "fontStyle": "italic"
      }
    },
    // Handlebars模板标签名的颜色
    {
      "scope": "meta.source.handlebars entity.name.tag",
      "settings": {
        "foreground": "#1ae1c4"
      }
    },
    // 表达式和标签标点的样式
    {
      "scope": "punctuation.definition.expression, punctuation.definition.subexpression, punctuation.definition.block.unescaped, punctuation.definition.tag",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FFCC95"
      }
    },
    // 函数表达式名称的颜色
    {
      "scope": "entity.name.function.expression",
      "settings": {
        "foreground": "#FF75B5"
      }
    },
    // 未转义表达式的颜色
    {
      "scope": "entity.unescaped.expression",
      "settings": {
        "foreground": "#B084EB"
      }
    },
    // 符号常量的颜色
    {
      "scope": "constant.other.symbol",
      "settings": {
        "foreground": "#19f9d8"
      }
    },
    // 表达式参数名的颜色
    {
      "scope": "entity.expression variable.parameter.name",
      "settings": {
        "foreground": "#FFB86C"
      }
    },
    // 表达式参数值的颜色
    {
      "scope": "entity.expression variable.parameter.value",
      "settings": {
        "foreground": "#1ae1c4"
      }
    },
    // 表达式中内置函数的颜色
    {
      "scope": "entity.expression support.function.builtin",
      "settings": {
        "foreground": "#FF9AC1"
      }
    },
    // HTML标签名的颜色
    {
      "scope": "entity.name.tag.html",
      "settings": {
        "foreground": "#FFCC95"
      }
    },
    // Handlebars属性名的颜色
    {
      "scope": "entity.other.attribute-name.handlebars",
      "settings": {
        "foreground": "#FFCC95"
      }
    },
    // React组件的颜色和样式
    {
      "scope": "support.class.component",
      "settings": {
        "foreground": "#FF75B5",
        "fontStyle": "italic"
      }
    },
    // JSX标签名的颜色
    {
      "scope": "meta.tag.js entity.name.tag",
      "settings": {
        "foreground": "#FFCC95"
      }
    },
    // HTML属性名的颜色
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#FFB86C"
      }
    },
    // Markdown粗体文本的样式
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#FFB86C",
        "font-weight": "bold"
      }
    },
    // Markdown粗体标点的样式
    {
      "scope": "punctuation.definition.bold.markdown",
      "settings": {
        "foreground": "#FFCC95",
        "font-weight": "bold"
      }
    },
    // 更改文本的颜色
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#FF75B5"
      }
    },
    // 删除文本的颜色
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#FF2C6D"
      }
    },
    // Markdown斜体文本的样式
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#FF9AC1",
        "fontStyle": "italic"
      }
    },
    // Markdown斜体标点的样式
    {
      "scope": "punctuation.definition.italic.markdown",
      "settings": {
        "foreground": "#FF75B5",
        "fontStyle": "italic"
      }
    },
    // 插入文本的颜色
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#19f9d8"
      }
    },
    // Markdown标题标点的颜色
    {
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "#19f9d8"
      }
    },
    // Markdown章节名称的颜色
    {
      "scope": "entity.name.section.markdown",
      "settings": {
        "foreground": "#BBBBBB"
      }
    },
    // Markdown引用文本的颜色
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#FFB86C"
      }
    },
    // Markdown内联代码的样式
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#19f9d8",
        "fontStyle": "italic"
      }
    },
    // 列表项标点的颜色
    {
      "scope": "beginning.punctuation.definition.list",
      "settings": {
        "foreground": "#FF75B5"
      }
    },
    // Markdown代码块标点的颜色
    {
      "scope": "markup.fenced_code.block.markdown punctuation.definition.markdown",
